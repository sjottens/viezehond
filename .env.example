# Kopieer naar .env.local. Alles mag leeg blijven om lokaal de demo te draaien:
# - zonder SUPABASE_*  → nepdata in de map .data (reset met: npm run demo:reset)
# - zonder MOLLIE_*    → nep-betaalpagina waar je zelf kiest of de betaling lukt
# - zonder ADMIN_*     → beheer op /admin met wachtwoord "demo"
# In productie (next start / Vercel) is de demo uit, tenzij je DEMO_MODE=true zet.

# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=   # GEHEIM: nooit in frontend-code of git

# Mollie (Dashboard > Developers > API keys). Begin met de test_ key.
MOLLIE_API_KEY=

# Het adres waar de shop draait (zonder / aan het eind). Verplicht in productie.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Beheer: een sterk wachtwoord en een willekeurige string van minstens 32 tekens.
# Maak er een met: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Wachtwoord of secret wijzigen logt iedereen uit.
ADMIN_PASSWORD=
ADMIN_SECRET=

# DEMO_MODE=true

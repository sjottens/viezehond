# Het adres waar de shop draait (zonder / aan het eind)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Beheer: kies een sterk wachtwoord en een lange willekeurige geheime string
ADMIN_PASSWORD=kies-een-sterk-wachtwoord
ADMIN_SECRET=een-lange-willekeurige-string-van-minstens-32-tekens

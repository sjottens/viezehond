# Supabase (Project Settings > API)
SUPABASE_URL=https://jouwproject.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # GEHEIM: nooit in frontend-code of git

# Mollie (Dashboard > Developers > API keys). Begin met de test_ key.
